<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    <title>{{ shop.name }} &ndash; Coming Soon</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Baloo+2:wght@600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body style="min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; background-color: var(--color-cream); padding: 2rem;">
    <div style="background-color: var(--color-paper); border: 2px solid var(--color-ink); border-radius: var(--radius-xl); padding: 3rem 2rem; box-shadow: var(--shadow-pop-lg); max-width: 500px; width: 100%; text-align: center;">
      <img src="{{ 'logo.png' | asset_url }}" alt="The Local Discovery Box" style="width: 200px; margin: 0 auto 1.5rem;">
      <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 0.75rem;">Opening Soon</h1>
      <p class="text-ink-soft" style="font-size: 1rem; margin-bottom: 2rem;">Our first seasonal edition is being curated by local scouts. Check back shortly!</p>
      
      {% form 'storefront_password' %}
        {% if form.errors %}
          <div style="background-color: var(--color-coral-light); border: 2px solid var(--color-ink); border-radius: var(--radius-md); padding: 0.75rem; margin-bottom: 1rem; font-size: 0.85rem; font-weight: 700; color: var(--color-coral-dark);">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}
        <div style="display: flex; gap: 0.5rem;">
          <input type="password" name="password" placeholder="Store password" class="form-input" style="flex: 1;" required>
          <button type="submit" class="btn btn-coral btn-md">Enter</button>
        </div>
      {% endform %}
    </div>
  </body>
</html>

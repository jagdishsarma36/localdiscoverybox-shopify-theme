<section style="padding: 5rem 0; border-bottom: 2px solid var(--color-ink); background-color: var(--color-paper);">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3.5rem;">
      
      <!-- Left Column: Business Categories -->
      <div>
        <span class="pill pill-teal" style="margin-bottom: 0.75rem;">Who Can Join</span>
        <h2 style="font-size: clamp(2rem, 3.5vw, 2.75rem); font-weight: 800; margin-bottom: 1.25rem;">
          Types of Businesses Featured
        </h2>
        <p class="text-ink-soft" style="font-size: 1.05rem; line-height: 1.6; margin-bottom: 1.5rem;">
          We partner with independent makers and local brick-and-mortar shops across a wide variety of specialties:
        </p>

        <div style="display: flex; flex-wrap: wrap; gap: 0.6rem;">
          {% assign categories = "Coffee roasters & tea companies,Packaged food & pantry brands,Juice & beverage makers,Candle & fragrance studios,Skincare & botanical beauty,Boutiques & apparel brands,Jewelry & accessory designers,Ceramicists & craft makers,Home décor & goods,Pet-product companies,Local experience providers" | split: "," %}
          {% for cat in categories %}
            <span class="pill pill-cream" style="background-color: var(--color-cream); font-size: 0.85rem; padding: 0.4rem 0.85rem;">
              {{ cat }}
            </span>
          {% endfor %}
        </div>
      </div>

      <!-- Right Column: What We Handle -->
      <div style="border-radius: var(--radius-xl); border: 2px solid var(--color-ink); background-color: var(--color-sun-light); padding: 2.25rem; box-shadow: var(--shadow-pop);">
        <span class="pill pill-coral" style="margin-bottom: 0.75rem;">Hands-Off For You</span>
        <h3 style="font-size: 1.75rem; font-weight: 800; margin-bottom: 1.25rem;">
          What We Take Care Of
        </h3>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.85rem; font-weight: 600; font-size: 0.95rem;">
          <li style="display: flex; align-items: center; gap: 0.6rem;">
            <span style="width: 22px; height: 22px; border-radius: 50%; background-color: var(--color-teal); border: 2px solid var(--color-ink); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">{% render 'icon-check' %}</span>
            <span>Curating the themed regional collection</span>
          </li>
          <li style="display: flex; align-items: center; gap: 0.6rem;">
            <span style="width: 22px; height: 22px; border-radius: 50%; background-color: var(--color-teal); border: 2px solid var(--color-ink); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">{% render 'icon-check' %}</span>
            <span>Writing, designing, and printing the Maker Field Guide</span>
          </li>
          <li style="display: flex; align-items: center; gap: 0.6rem;">
            <span style="width: 22px; height: 22px; border-radius: 50%; background-color: var(--color-teal); border: 2px solid var(--color-ink); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">{% render 'icon-check' %}</span>
            <span>Custom QR attribution link creation & tracking</span>
          </li>
          <li style="display: flex; align-items: center; gap: 0.6rem;">
            <span style="width: 22px; height: 22px; border-radius: 50%; background-color: var(--color-teal); border: 2px solid var(--color-ink); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">{% render 'icon-check' %}</span>
            <span>Assembling and custom packaging every individual box</span>
          </li>
          <li style="display: flex; align-items: center; gap: 0.6rem;">
            <span style="width: 22px; height: 22px; border-radius: 50%; background-color: var(--color-teal); border: 2px solid var(--color-ink); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">{% render 'icon-check' %}</span>
            <span>Handling shipping logistics and subscriber support</span>
          </li>
          <li style="display: flex; align-items: center; gap: 0.6rem;">
            <span style="width: 22px; height: 22px; border-radius: 50%; background-color: var(--color-teal); border: 2px solid var(--color-ink); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">{% render 'icon-check' %}</span>
            <span>Local press, social media, and community promotion</span>
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Business Types",
  "settings": [],
  "presets": [
    {
      "name": "Brand Business Types"
    }
  ]
}
{% endschema %}

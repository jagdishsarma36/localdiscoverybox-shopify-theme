<section style="padding: 5rem 0; border-bottom: 2px solid var(--color-ink); background-color: var(--color-paper);">
  <div class="container">
    <div style="text-align: center; max-width: 600px; margin: 0 auto 3.5rem;">
      <span class="pill pill-teal" style="margin-bottom: 0.75rem;">Simple Process</span>
      <h2 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; margin-bottom: 1rem;">
        How It Works
      </h2>
      <p class="text-ink-soft" style="font-size: 1.1rem;">
        From discovery in Appalachian workshops to your kitchen table in three simple steps.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
      <!-- Step 1 -->
      <div style="border-radius: var(--radius-xl); border: 2px solid var(--color-ink); background-color: var(--color-cream); padding: 2rem; box-shadow: var(--shadow-pop); position: relative;">
        <span class="pill pill-coral" style="position: absolute; -top: 14px; left: 1.5rem; font-size: 0.85rem; font-weight: 800;">
          STEP 01
        </span>
        <div style="width: 52px; height: 52px; border-radius: var(--radius-md); border: 2px solid var(--color-ink); background-color: var(--color-sun); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin: 0.75rem 0 1.25rem;">
          🔍
        </div>
        <h3 style="font-size: 1.45rem; font-weight: 800; margin-bottom: 0.75rem;">
          We Curate
        </h3>
        <p class="text-ink-soft" style="font-size: 0.95rem; line-height: 1.6;">
          Our local scouts visit workshops, roasteries, and farms. We select 6 exceptional items from true regional artisans.
        </p>
      </div>

      <!-- Step 2 -->
      <div style="border-radius: var(--radius-xl); border: 2px solid var(--color-ink); background-color: var(--color-sun-light); padding: 2rem; box-shadow: var(--shadow-pop); position: relative;">
        <span class="pill pill-teal" style="position: absolute; -top: 14px; left: 1.5rem; font-size: 0.85rem; font-weight: 800;">
          STEP 02
        </span>
        <div style="width: 52px; height: 52px; border-radius: var(--radius-md); border: 2px solid var(--color-ink); background-color: var(--color-teal); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin: 0.75rem 0 1.25rem;">
          📦
        </div>
        <h3 style="font-size: 1.45rem; font-weight: 800; margin-bottom: 0.75rem;">
          You Unbox
        </h3>
        <p class="text-ink-soft" style="font-size: 0.95rem; line-height: 1.6;">
          Your box arrives seasonally at your door, thoughtfully packed with samples, products, and the printed field guide.
        </p>
      </div>

      <!-- Step 3 -->
      <div style="border-radius: var(--radius-xl); border: 2px solid var(--color-ink); background-color: var(--color-coral-light); padding: 2rem; box-shadow: var(--shadow-pop); position: relative;">
        <span class="pill pill-berry" style="position: absolute; -top: 14px; left: 1.5rem; font-size: 0.85rem; font-weight: 800;">
          STEP 03
        </span>
        <div style="width: 52px; height: 52px; border-radius: var(--radius-md); border: 2px solid var(--color-ink); background-color: var(--color-coral); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin: 0.75rem 0 1.25rem;">
          ✨
        </div>
        <h3 style="font-size: 1.45rem; font-weight: 800; margin-bottom: 0.75rem;">
          Support & Save
        </h3>
        <p class="text-ink-soft" style="font-size: 0.95rem; line-height: 1.6;">
          Scan the QR codes inside to redeem subscriber-exclusive vouchers and keep ordering directly from your new favorite businesses.
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "settings": [],
  "presets": [
    {
      "name": "How It Works"
    }
  ]
}
{% endschema %}

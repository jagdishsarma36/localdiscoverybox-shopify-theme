<section style="padding: 5rem 0 6rem; background-color: var(--color-cream);">
  <div class="container-narrow" style="max-width: 480px;">
    <div style="background-color: var(--color-paper); border: 2px solid var(--color-ink); border-radius: var(--radius-xl); padding: 2.5rem 2rem; box-shadow: var(--shadow-pop-lg);">
      
      <div style="text-align: center; margin-bottom: 2rem;">
        <span class="pill pill-teal" style="margin-bottom: 0.75rem;">Account Access</span>
        <h1 style="font-size: 2.2rem; font-weight: 800;">Log In</h1>
        <p class="text-ink-soft" style="font-size: 0.95rem;">Access your subscriptions, box tracking, and delivery preferences.</p>
      </div>

      {% form 'customer_login' %}
        {% if form.errors %}
          <div style="background-color: var(--color-coral-light); border: 2px solid var(--color-ink); border-radius: var(--radius-md); padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.85rem; font-weight: 700; color: var(--color-coral-dark);">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div style="margin-bottom: 1.25rem;">
          <label class="form-label">Email</label>
          <input type="email" name="customer[email]" class="form-input" placeholder="you@example.com" required>
        </div>

        <div style="margin-bottom: 1.75rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
            <label class="form-label" style="margin: 0;">Password</label>
            <a href="#recover" onclick="document.getElementById('RecoverPasswordForm').style.display='block'; document.getElementById('CustomerLoginForm').style.display='none'; return false;" style="font-size: 0.8rem; font-weight: 600; color: var(--color-coral);">Forgot?</a>
          </div>
          <input type="password" name="customer[password]" class="form-input" placeholder="••••••••" required>
        </div>

        <button type="submit" class="btn btn-coral btn-lg" style="width: 100%; margin-bottom: 1.25rem;">
          <span>Sign In</span>
          {% render 'icon-arrow-right' %}
        </button>

        <div style="text-align: center; font-size: 0.9rem;">
          <span class="text-ink-soft">Don't have an account yet?</span>
          <a href="/account/register" style="font-weight: 700; color: var(--color-coral); margin-left: 0.35rem;">Create Account</a>
        </div>
      {% endform %}

    </div>
  </div>
</section>

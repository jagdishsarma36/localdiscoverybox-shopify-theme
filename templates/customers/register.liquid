<section style="padding: 5rem 0 6rem; background-color: var(--color-cream);">
  <div class="container-narrow" style="max-width: 480px;">
    <div style="background-color: var(--color-paper); border: 2px solid var(--color-ink); border-radius: var(--radius-xl); padding: 2.5rem 2rem; box-shadow: var(--shadow-pop-lg);">
      
      <div style="text-align: center; margin-bottom: 2rem;">
        <span class="pill pill-sun" style="margin-bottom: 0.75rem;">Join Discovery</span>
        <h1 style="font-size: 2.2rem; font-weight: 800;">Create Account</h1>
        <p class="text-ink-soft" style="font-size: 0.95rem;">Save your shipping info, manage recurring boxes, and access subscriber perks.</p>
      </div>

      {% form 'create_customer' %}
        {% if form.errors %}
          <div style="background-color: var(--color-coral-light); border: 2px solid var(--color-ink); border-radius: var(--radius-md); padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.85rem; font-weight: 700; color: var(--color-coral-dark);">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div style="margin-bottom: 1.25rem;">
          <label class="form-label">First Name</label>
          <input type="text" name="customer[first_name]" class="form-input" placeholder="Jane" required>
        </div>

        <div style="margin-bottom: 1.25rem;">
          <label class="form-label">Last Name</label>
          <input type="text" name="customer[last_name]" class="form-input" placeholder="Doe" required>
        </div>

        <div style="margin-bottom: 1.25rem;">
          <label class="form-label">Email</label>
          <input type="email" name="customer[email]" class="form-input" placeholder="jane@example.com" required>
        </div>

        <div style="margin-bottom: 1.75rem;">
          <label class="form-label">Password</label>
          <input type="password" name="customer[password]" class="form-input" placeholder="••••••••" required>
        </div>

        <button type="submit" class="btn btn-coral btn-lg" style="width: 100%; margin-bottom: 1.25rem;">
          <span>Create Account</span>
          {% render 'icon-arrow-right' %}
        </button>

        <div style="text-align: center; font-size: 0.9rem;">
          <span class="text-ink-soft">Already have an account?</span>
          <a href="/account/login" style="font-weight: 700; color: var(--color-coral); margin-left: 0.35rem;">Log In</a>
        </div>
      {% endform %}

    </div>
  </div>
</section>

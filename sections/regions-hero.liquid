<section style="padding: 4.5rem 0 3rem; background-color: var(--color-teal-light); border-bottom: 2px solid var(--color-ink); text-align: center;">
  <div class="container-narrow">
    <span class="pill pill-paper" style="margin-bottom: 1rem;">
      {% render 'icon-map-pin' %}
      <span>All State Regions</span>
    </span>
    <h1 style="font-size: clamp(2.4rem, 5vw, 4rem); font-weight: 800; margin-bottom: 1rem;">
      Discover your state.
    </h1>
    <p class="text-ink-soft" style="font-size: 1.2rem; line-height: 1.6; max-width: 620px; margin: 0 auto 2rem;">
      The Local Discovery Box is live in Southwest Virginia and expanding across the United States. Find your region, explore what's inside, or get on the waitlist for your home state.
    </p>

    <!-- Filter Buttons -->
    <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
      <button type="button" class="btn btn-coral btn-sm" data-region-filter="all">All Regions</button>
      <button type="button" class="btn btn-sun btn-sm" data-region-filter="current">Available Now</button>
      <button type="button" class="btn btn-sun btn-sm" data-region-filter="upcoming">Coming Soon</button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Regions Hero",
  "settings": [],
  "presets": [
    {
      "name": "Regions Hero"
    }
  ]
}
{% endschema %}

<section style="position: relative; overflow: hidden; padding: 4rem 0 5rem; border-bottom: 2px solid var(--color-ink); background-color: var(--color-sun-light);">
  <div class="container" style="position: relative; z-index: 2;">
    <div style="text-align: center; max-width: 800px; margin: 0 auto;">
      <span class="pill pill-paper" style="margin-bottom: 1rem;">
        For Local Brands & Makers
      </span>
      <h1 style="font-size: clamp(2.4rem, 5vw, 4rem); font-weight: 800; line-height: 1.1; margin-bottom: 1.25rem;">
        Get Your Brand Inside the Local Discovery Box
      </h1>
      <p style="font-size: 1.25rem; font-weight: 700; color: var(--color-ink); margin-bottom: 1rem;">
        Put your products in front of more discovery-loving local customers.
      </p>
      <p class="text-ink-soft" style="font-size: 1.1rem; line-height: 1.6; margin-bottom: 1.25rem;">
        Local Discovery Box helps shoppers discover the standout businesses, makers, and experiences that make their region special. For participating businesses, it is the highest-engagement way to introduce your brand, generate real awareness, and earn repeat local customers.
      </p>
      <p class="text-ink-soft" style="font-size: 1rem; line-height: 1.6; margin-bottom: 2rem;">
        Whether you produce specialty coffee, botanical skincare, artisan candles, handcrafted goods, or specialty foods — Local Discovery Box gets your product straight into qualified homes.
      </p>
      <a href="#apply" class="btn btn-coral btn-lg">
        <span>Apply to join the next box</span>
        {% render 'icon-arrow-right' %}
      </a>
    </div>

    <!-- Finn Mascot Graphic -->
    <figure class="mascot-container" style="position: absolute; bottom: 0; right: 2rem; display: none;" id="BrandFinnMascot">
      <img src="{{ 'finn_mascot.png' | asset_url }}" alt="Finn the squirrel mascot" style="height: 180px; width: auto;">
      <figcaption class="mascot-caption">Finn the Scout</figcaption>
    </figure>

    <script>
      if (window.innerWidth > 992) {
        document.getElementById('BrandFinnMascot').style.display = 'flex';
      }
    </script>
  </div>
</section>

{% schema %}
{
  "name": "Brand Hero",
  "settings": [],
  "presets": [
    {
      "name": "Brand Hero"
    }
  ]
}
{% endschema %}

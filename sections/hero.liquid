<section
  class="hero-section"
  style="
    position: relative;
    overflow: hidden;
    padding: 3.5rem 0 4.5rem;
    border-bottom: 2px solid var(--color-ink);
  "
>

  {% comment %}
    =========================================
    DECORATIVE GLOWS
    =========================================
  {% endcomment %}

  {% if section.settings.show_glow_left %}
    <div
      style="
        position: absolute;
        top: 3rem;
        left: -3rem;
        width: 14rem;
        height: 14rem;
        border-radius: 50%;
        background-color: {{ section.settings.glow_left_color | color_modify: 'alpha', 0.45 }};
        filter: blur({{ section.settings.glow_left_blur }}px);
        pointer-events: none;
      "
    ></div>
  {% endif %}

  {% if section.settings.show_glow_right %}
    <div
      style="
        position: absolute;
        bottom: 2rem;
        right: -2rem;
        width: 18rem;
        height: 18rem;
        border-radius: 50%;
        background-color: {{ section.settings.glow_right_color | color_modify: 'alpha', 0.4 }};
        filter: blur({{ section.settings.glow_right_blur }}px);
        pointer-events: none;
      "
    ></div>
  {% endif %}


  <div
    class="container"
    style="
      position: relative;
      z-index: 2;
    "
  >

    <div
      style="
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 3.5rem;
        align-items: center;
      "
    >

      {% comment %}
        =========================================
        HERO LEFT COLUMN
        =========================================
      {% endcomment %}

      <div class="animate-pop-in">

        {% comment %}
          =========================================
          REGION SELECTOR
          =========================================
        {% endcomment %}

        {% if section.settings.show_region_selector %}

          <div
            style="
              display: flex;
              flex-wrap: wrap;
              align-items: center;
              gap: 0.75rem;
              margin-bottom: 1.25rem;
            "
          >

            <div
              style="
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                border-radius: var(--radius-full);
                border: 2px solid var(--color-ink);
                background-color: var(--color-paper);
                padding: 0.35rem 0.85rem;
                box-shadow: var(--shadow-pop-sm);
              "
            >

              {% render 'icon-map-pin' %}

              <select
                style="
                  background: none;
                  border: none;
                  font-family: var(--font-display);
                  font-weight: 700;
                  font-size: 0.9rem;
                  color: var(--color-ink);
                  outline: none;
                  cursor: pointer;
                "
                onchange="
                  if(this.value) {
                    window.location.href = this.value;
                  }
                "
              >

                {% for block in section.blocks %}

                  {% if block.type == 'region' %}

                    <option
                      value="{{ block.settings.region_url }}"
                      {% if block.settings.selected %}
                        selected
                      {% endif %}
                    >
                      {{ block.settings.region_name }}
                    </option>

                  {% endif %}

                {% endfor %}

              </select>

            </div>


            {% if section.settings.show_region_button %}

              <a
                href="{{ section.settings.region_button_link | default: '/pages/regions' }}"
                class="pill pill-sun"
                style="
                  text-decoration: none;
                  box-shadow: var(--shadow-pop-sm);
                  transition: transform var(--transition-fast);
                "
              >

                <span>
                  {{ section.settings.region_button_text }}
                </span>

                {% render 'icon-arrow-right' %}

              </a>

            {% endif %}

          </div>

        {% endif %}


        {% comment %}
          =========================================
          HEADLINE
          =========================================
        {% endcomment %}

        {% if section.settings.headline_line_1 != blank
          or section.settings.headline_line_2 != blank
        %}

          <h1
            style="
              font-size: clamp(2.5rem, 5.5vw, 4rem);
              font-weight: 800;
              line-height: 1.08;
              margin-bottom: 1.25rem;
            "
          >

            {% if section.settings.headline_line_1 != blank %}
              {{ section.settings.headline_line_1 }}
            {% endif %}

            {% if section.settings.headline_line_2 != blank %}

              <br>

              <span
                style="
                  color: {{ section.settings.headline_color }};
                  white-space: nowrap;
                "
              >
                {{ section.settings.headline_line_2 }}
              </span>

            {% endif %}

          </h1>

        {% endif %}


        {% comment %}
          =========================================
          SUBHEADING
          =========================================
        {% endcomment %}

        {% if section.settings.subheading != blank %}

          <div
            class="text-ink-soft hero-subheading"
            style="
              font-size: 1.15rem;
              max-width: 520px;
              line-height: 1.6;
              margin-bottom: 1.75rem;
            "
          >
            {{ section.settings.subheading }}
          </div>

        {% endif %}


        {% comment %}
          =========================================
          CTA BUTTONS
          =========================================
        {% endcomment %}

        {% if section.settings.show_ctas %}

          <div
            style="
              display: flex;
              flex-wrap: wrap;
              gap: 1rem;
              margin-bottom: 2rem;
            "
          >

            {% if section.settings.primary_cta_text != blank %}

              <a
                href="{{ section.settings.primary_cta_link | default: '/products/the-local-discovery-box' }}"
                class="btn btn-coral btn-lg"
              >

                <span>
                  {{ section.settings.primary_cta_text }}
                </span>

                {% if section.settings.primary_cta_arrow %}
                  {% render 'icon-arrow-right' %}
                {% endif %}

              </a>

            {% endif %}


            {% if section.settings.secondary_cta_text != blank %}

              <a
                href="{{ section.settings.secondary_cta_link | default: '/pages/subscribe' }}"
                class="btn btn-teal btn-lg"
              >

                <span>
                  {{ section.settings.secondary_cta_text }}
                </span>

                {% if section.settings.secondary_cta_arrow %}
                  {% render 'icon-arrow-right' %}
                {% endif %}

              </a>

            {% endif %}

          </div>

        {% endif %}


        {% comment %}
          =========================================
          COMING SOON CARD
          =========================================
        {% endcomment %}

        {% if section.settings.show_coming_soon %}

          <div
            style="
              margin-top: 2rem;
              max-width: {{ section.settings.coming_soon_width }}px;
              border-radius: 1rem;
              border: 2px solid var(--color-ink);
              background-color: var(--color-paper);
              padding: 1rem;
              box-shadow: var(--shadow-pop);
            "
          >

            {% if section.settings.coming_soon_label != blank %}

              <div
                style="
                  font-family: var(--font-display);
                  font-size: 0.875rem;
                  font-weight: 800;
                  color: var(--color-coral-dark);
                  text-transform: uppercase;
                  letter-spacing: 0.05em;
                "
              >
                {{ section.settings.coming_soon_label }}
              </div>

            {% endif %}


            {% if section.settings.coming_soon_title != blank %}

              <div
                style="
                  margin-top: 0.25rem;
                  font-family: var(--font-display);
                  font-size: 1.25rem;
                  font-weight: 800;
                "
              >
                {{ section.settings.coming_soon_title }}
              </div>

            {% endif %}


            {% if section.settings.coming_soon_date != blank %}

              <p
                class="text-ink-soft"
                style="
                  margin-top: 0.25rem;
                  margin-bottom: 0;
                  font-size: 0.75rem;
                  font-weight: 600;
                "
              >
                {{ section.settings.coming_soon_date }}
              </p>

            {% endif %}


            {% if section.settings.coming_soon_description != blank %}

              <div
                class="text-ink-soft"
                style="
                  margin-top: 0.5rem;
                  font-size: 0.75rem;
                  font-weight: 600;
                  line-height: 1.5;
                "
              >
                {{ section.settings.coming_soon_description }}
              </div>

            {% endif %}

          </div>

        {% endif %}

      </div>


      {% comment %}
        =========================================
        HERO RIGHT COLUMN
        =========================================
      {% endcomment %}

      <div
        style="
          position: relative;
          display: flex;
          flex-direction: column;
          align-items: center;
        "
      >

        {% comment %}
          =========================================
          BADGE 1
          =========================================
        {% endcomment %}

        {% if section.settings.show_badge_1
          and section.settings.badge_1_text != blank
        %}

          <div
            class="pill pill-sun rot-neg-6"
            style="
              position: absolute;
              top: 1.5rem;
              left: 1rem;
              font-size: 0.95rem;
              font-weight: 800;
              padding: 0.5rem 1rem;
              box-shadow: var(--shadow-pop-sm);
              z-index: 99999;
            "
          >
            {{ section.settings.badge_1_text }}
          </div>

        {% endif %}


        {% comment %}
          =========================================
          HERO IMAGE
          =========================================
        {% endcomment %}

        <div
          class="animate-float"
          style="
            position: relative;
            width: 100%;
            max-width: {{ section.settings.hero_image_width }}px;
            border-radius: var(--radius-xl);
            border: 2px solid var(--color-ink);
            background-color: var(--color-paper);
            box-shadow: var(--shadow-pop-lg);
            overflow: hidden;
          "
        >

          {% if section.settings.hero_image != blank %}

            <img
              src="{{ section.settings.hero_image | image_url: width: 1200 }}"
              alt="{{ section.settings.hero_image_alt | escape }}"
              width="{{ section.settings.hero_image.width }}"
              height="{{ section.settings.hero_image.height }}"
              loading="eager"
              style="
                width: 100%;
                aspect-ratio: 4/4;
                object-fit: cover;
              "
            >

          {% else %}

            <img
              src="{{ 'box_hero.webp' | asset_url }}"
              alt="{{ section.settings.hero_image_alt | escape }}"
              style="
                width: 100%;
                aspect-ratio: 4/4;
                object-fit: cover;
              "
            >

          {% endif %}

        </div>


        {% comment %}
          =========================================
          MASCOT + BADGE 2
          =========================================
        {% endcomment %}

        {% if section.settings.show_mascot
          or section.settings.show_badge_2
        %}

          <div
            class="mascot-container badge-mascot"
            style="
              margin-left: auto;
              padding-right: 40px;
              margin-top: -15px;
            "
            id="HeroFinnMascot"
          >

            {% if section.settings.show_badge_2
              and section.settings.badge_2_text != blank
            %}

              <div
                class="pill pill-berry rot-pos-3"
                style="
                  font-size: 0.95rem;
                  margin-bottom: 5px;
                  font-weight: 800;
                  padding: 0.5rem 1rem;
                  box-shadow: var(--shadow-pop-sm);
                "
              >
                {{ section.settings.badge_2_text }}
              </div>

            {% endif %}


            {% if section.settings.show_mascot %}

              <figure class="mascot-cap">

                <figcaption class="mascot-caption">
                  {{ section.settings.mascot_caption }}
                </figcaption>

                {% if section.settings.mascot_image != blank %}

                  <img
                    src="{{ section.settings.mascot_image | image_url: width: 500 }}"
                    alt="{{ section.settings.mascot_alt | escape }}"
                    width="{{ section.settings.mascot_image.width }}"
                    height="{{ section.settings.mascot_image.height }}"
                    loading="lazy"
                    style="
                      height: 140px;
                      width: auto;
                    "
                  >

                {% else %}

                  <img
                    src="{{ 'finn_mascot.png' | asset_url }}"
                    alt="{{ section.settings.mascot_alt | escape }}"
                    loading="lazy"
                    style="
                      height: 140px;
                      width: auto;
                    "
                  >

                {% endif %}

              </figure>

            {% endif %}

          </div>

        {% endif %}

      </div>

    </div>

  </div>

</section>
<section class="hero-section" style="position: relative; overflow: hidden; padding: 3.5rem 0 4.5rem; border-bottom: 2px solid var(--color-ink);">
  <!-- Decorative Glows -->
  <div style="position: absolute; top: 3rem; left: -3rem; width: 14rem; height: 14rem; border-radius: 50%; background-color: rgba(255, 209, 102, 0.45); filter: blur(50px); pointer-events: none;"></div>
  <div style="position: absolute; bottom: 2rem; right: -2rem; width: 18rem; height: 18rem; border-radius: 50%; background-color: rgba(122, 226, 206, 0.4); filter: blur(60px); pointer-events: none;"></div>

  <div class="container" style="position: relative; z-index: 2;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3.5rem; align-items: center;">
      <!-- Hero Left Column -->
      <div class="animate-pop-in">
        <!-- Region Selector Pill -->
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem;">
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; border-radius: var(--radius-full); border: 2px solid var(--color-ink); background-color: var(--color-paper); padding: 0.35rem 0.85rem; box-shadow: var(--shadow-pop-sm);">
            {% render 'icon-map-pin' %}
            <select style="background: none; border: none; font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; color: var(--color-ink); outline: none; cursor: pointer;" onchange="if(this.value) window.location.href='/pages/regions#' + this.value">
              <option value="southwest-va" selected>SW Virginia (Now Available)</option>
              <option value="blue-ridge-nc">Blue Ridge, NC (Summer 2027)</option>
              <option value="texas-hill-country">Texas Hill Country, TX (Fall 2027)</option>
              <option value="pacific-northwest">Pacific Northwest (Winter 2027)</option>
            </select>
          </div>
          <a href="/pages/regions" class="pill pill-sun" style="text-decoration: none; box-shadow: var(--shadow-pop-sm); transition: transform var(--transition-fast);">
            <span>View page</span>
            {% render 'icon-arrow-right' %}
          </a>
        </div>

        <!-- Headline -->
        <h1 style="font-size: clamp(2.5rem, 5.5vw, 4rem); font-weight: 800; line-height: 1.08; margin-bottom: 1.25rem;">
          Meet your state's<br>
          <span style="color: var(--color-coral); white-space: nowrap;">best-kept secrets.</span>
        </h1>

        <!-- Subheading -->
        <p class="text-ink-soft" style="font-size: 1.15rem; max-width: 520px; line-height: 1.6; margin-bottom: 1.75rem;">
          A themed box of small local brands with samples, stories, and exclusive offers, curated by locals and made for the unboxing. Discover six brands from your state at once.
        </p>

        <!-- CTA Buttons -->
        <div style="display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
          <a href="/products/the-local-discovery-box" class="btn btn-coral btn-lg">
            <span>Get the box</span>
            {% render 'icon-arrow-right' %}
          </a>
          <a href="/pages/subscribe" class="btn btn-teal btn-lg">
            <span>Subscribe & save</span>
          </a>
        </div>

        <!-- Scarcity / Progress Meter -->
        <div class="scarcity-box" data-scarcity-bar data-total="100" data-remaining="34" style="max-width: 400px;">
          <div style="display: flex; justify-content: space-between; align-items: center; font-family: var(--font-display); font-weight: 800; font-size: 0.95rem;">
            <span>34 of 100 boxes left</span>
            <span style="color: var(--color-coral-dark);">$59 / box</span>
          </div>
          <div class="scarcity-bar-bg">
            <div class="scarcity-bar-fill" style="width: 66%;"></div>
          </div>
          <p class="text-ink-soft" style="font-size: 0.8rem; font-weight: 600; margin-top: 0.5rem;">
            Limited first run. Once they're gone, they're gone.
          </p>
        </div>
      </div>

      <!-- Hero Right Column (Opened Box with Badges & Mascots) -->
      <div style="position: relative; display: flex; flex-direction: column; align-items: center;">
        <div class="animate-float" style="position: relative; width: 100%; max-width: 480px; border-radius: var(--radius-xl); border: 2px solid var(--color-ink); background-color: var(--color-paper); box-shadow: var(--shadow-pop-lg); overflow: hidden;">
          <img src="{{ 'box_hero.webp' | asset_url }}" alt="The Local Discovery Box, opened with products" style="width: 100%; aspect-ratio: 4/4; object-fit: cover;">
          
          <!-- Floating Badge 1 -->
          <div class="pill pill-sun rot-neg-6" style="position: absolute; top: 1.5rem; left: -0.75rem; font-size: 0.95rem; font-weight: 800; padding: 0.5rem 1rem; box-shadow: var(--shadow-pop-sm);">
            6 brands inside
          </div>
        </div>

        <div class="mascot-container badge-mascot" style="margin-left: auto; padding-right: 40px; margin-top: -15px;" id="HeroFinnMascot">
          <!-- Floating Badge 2 -->
          <div class="pill pill-berry rot-pos-3" style=" font-size: 0.95rem; margin-bottom: 5px; font-weight: 800; padding: 0.5rem 1rem; box-shadow: var(--shadow-pop-sm);">
            Real samples & stories
          </div>
        
        <!-- Mascot Finn the Squirrel -->
        <figure style="display: flex;>
          <img src="{{ 'finn_mascot.png' | asset_url }}" alt="Finn the squirrel mascot" style="height: 140px; width: auto;">
          <figcaption class="mascot-caption">Finn</figcaption>
        </figure>
        </div>

        <script>
          if (window.innerWidth > 992) {
            document.getElementById('HeroLoMascot').style.display = 'flex';
            document.getElementById('HeroFinnMascot').style.display = 'flex';
          }
        </script>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Meet your state's best-kept secrets."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A themed box of small local brands with samples, stories, and exclusive offers, curated by locals and made for the unboxing. Discover six brands from your state at once."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA Text",
      "default": "Get the box"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA Link"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Text",
      "default": "Subscribe & save"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Section"
    }
  ]
}
{% endschema %}

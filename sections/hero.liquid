          }
        },

        {
          "type": "region",
          "settings": {
            "region_name": "Texas Hill Country, TX (Fall 2027)",
            "region_url": "/pages/regions#texas-hill-country",
            "selected": false
          }
        },

        {
          "type": "region",
          "settings": {
            "region_name": "Pacific Northwest (Winter 2027)",
            "region_url": "/pages/regions#pacific-northwest",
            "selected": false
          }
        }

      ]

    }

  ]

}


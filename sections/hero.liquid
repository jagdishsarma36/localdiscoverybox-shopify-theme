<section
  class="hero-section"
  style="
    position: relative;
    overflow: hidden;
    padding: 3.5rem 0 4.5rem;
    border-bottom: 2px solid var(--color-ink);
  "
>

  {% comment %}
    =========================================
    DECORATIVE GLOWS
    =========================================
  {% endcomment %}

  {% if section.settings.show_glow_left %}
    <div
      style="
        position: absolute;
        top: 3rem;
        left: -3rem;
        width: 14rem;
        height: 14rem;
        border-radius: 50%;
        background-color: {{ section.settings.glow_left_color | color_modify: 'alpha', 0.45 }};
        filter: blur({{ section.settings.glow_left_blur }}px);
        pointer-events: none;
      "
    ></div>
  {% endif %}

  {% if section.settings.show_glow_right %}
    <div
      style="
        position: absolute;
        bottom: 2rem;
        right: -2rem;
        width: 18rem;
        height: 18rem;
        border-radius: 50%;
        background-color: {{ section.settings.glow_right_color | color_modify: 'alpha', 0.4 }};
        filter: blur({{ section.settings.glow_right_blur }}px);
        pointer-events: none;
      "
    ></div>
  {% endif %}


  <div
    class="container"
    style="
      position: relative;
      z-index: 2;
    "
  >

    <div
      style="
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 3.5rem;
        align-items: center;
      "
    >

      {% comment %}
        =========================================
        HERO LEFT COLUMN
        =========================================
      {% endcomment %}

      <div class="animate-pop-in">

        {% comment %}
          =========================================
          REGION SELECTOR
          =========================================
        {% endcomment %}

        {% if section.settings.show_region_selector %}

          <div
            style="
              display: flex;
              flex-wrap: wrap;
              align-items: center;
              gap: 0.75rem;
              margin-bottom: 1.25rem;
            "
          >

            <div
              style="
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                border-radius: var(--radius-full);
                border: 2px solid var(--color-ink);
                background-color: var(--color-paper);
                padding: 0.35rem 0.85rem;
                box-shadow: var(--shadow-pop-sm);
              "
            >

              {% render 'icon-map-pin' %}

              <select
                style="
                  background: none;
                  border: none;
                  font-family: var(--font-display);
                  font-weight: 700;
                  font-size: 0.9rem;
                  color: var(--color-ink);
                  outline: none;
                  cursor: pointer;
                "
                onchange="
                  if(this.value) {
                    window.location.href = this.value;
                  }
                "
              >

                {% for block in section.blocks %}

                  {% if block.type == 'region' %}

                    <option
                      value="{{ block.settings.region_url }}"
                      {% if block.settings.selected %}
                        selected
                      {% endif %}
                    >
                      {{ block.settings.region_name }}
                    </option>

                  {% endif %}

                {% endfor %}

              </select>

            </div>


            {% if section.settings.show_region_button %}

              <a
                href="{{ section.settings.region_button_link | default: '/pages/regions' }}"
                class="pill pill-sun"
                style="
                  text-decoration: none;
                  box-shadow: var(--shadow-pop-sm);
                  transition: transform var(--transition-fast);
                "
              >

                <span>
                  {{ section.settings.region_button_text }}
                </span>

                {% render 'icon-arrow-right' %}

              </a>

            {% endif %}

          </div>

        {% endif %}


        {% comment %}
          =========================================
          HEADLINE
          =========================================
        {% endcomment %}

        {% if section.settings.headline_line_1 != blank
          or section.settings.headline_line_2 != blank
        %}

          <h1
            style="
              font-size: clamp(2.5rem, 5.5vw, 4rem);
              font-weight: 800;
              line-height: 1.08;
              margin-bottom: 1.25rem;
            "
          >

            {% if section.settings.headline_line_1 != blank %}
              {{ section.settings.headline_line_1 }}
            {% endif %}

            {% if section.settings.headline_line_2 != blank %}

              <br>

              <span
                style="
                  color: {{ section.settings.headline_color }};
                  white-space: nowrap;
                "
              >
                {{ section.settings.headline_line_2 }}
              </span>

            {% endif %}

          </h1>

        {% endif %}


        {% comment %}
          =========================================
          SUBHEADING
          =========================================
        {% endcomment %}

        {% if section.settings.subheading != blank %}

          <div
            class="text-ink-soft hero-subheading"
            style="
              font-size: 1.15rem;
              max-width: 520px;
              line-height: 1.6;
              margin-bottom: 1.75rem;
            "
          >
            {{ section.settings.subheading }}
          </div>

        {% endif %}


        {% comment %}
          =========================================
          CTA BUTTONS
          =========================================
        {% endcomment %}

        {% if section.settings.show_ctas %}

          <div
            style="
              display: flex;
              flex-wrap: wrap;
              gap: 1rem;
              margin-bottom: 2rem;
            "
          >

            {% if section.settings.primary_cta_text != blank %}

              <a
                href="{{ section.settings.primary_cta_link | default: '/products/the-local-discovery-box' }}"
                class="btn btn-coral btn-lg"
              >

                <span>
                  {{ section.settings.primary_cta_text }}
                </span>

                {% if section.settings.primary_cta_arrow %}
                  {% render 'icon-arrow-right' %}
                {% endif %}

              </a>

            {% endif %}


            {% if section.settings.secondary_cta_text != blank %}

              <a
                href="{{ section.settings.secondary_cta_link | default: '/pages/subscribe' }}"
                class="btn btn-teal btn-lg"
              >

                <span>
                  {{ section.settings.secondary_cta_text }}
                </span>

                {% if section.settings.secondary_cta_arrow %}
                  {% render 'icon-arrow-right' %}
                {% endif %}

              </a>

            {% endif %}

          </div>

        {% endif %}


        {% comment %}
          =========================================
          COMING SOON CARD
          =========================================
        {% endcomment %}

        {% if section.settings.show_coming_soon %}

          <div
            style="
              margin-top: 2rem;
              max-width: {{ section.settings.coming_soon_width }}px;
              border-radius: 1rem;
              border: 2px solid var(--color-ink);
              background-color: var(--color-paper);
              padding: 1rem;
              box-shadow: var(--shadow-pop);
            "
          >

            {% if section.settings.coming_soon_label != blank %}

              <div
                style="
                  font-family: var(--font-display);
                  font-size: 0.875rem;
                  font-weight: 800;
                  color: var(--color-coral-dark);
                  text-transform: uppercase;
                  letter-spacing: 0.05em;
                "
              >
                {{ section.settings.coming_soon_label }}
              </div>

            {% endif %}


            {% if section.settings.coming_soon_title != blank %}

              <div
                style="
                  margin-top: 0.25rem;
                  font-family: var(--font-display);
                  font-size: 1.25rem;
                  font-weight: 800;
                "
              >
                {{ section.settings.coming_soon_title }}
              </div>

            {% endif %}


            {% if section.settings.coming_soon_date != blank %}

              <p
                class="text-ink-soft"
                style="
                  margin-top: 0.25rem;
                  margin-bottom: 0;
                  font-size: 0.75rem;
                  font-weight: 600;
                "
              >
                {{ section.settings.coming_soon_date }}
              </p>

            {% endif %}


            {% if section.settings.coming_soon_description != blank %}

              <div
                class="text-ink-soft"
                style="
                  margin-top: 0.5rem;
                  font-size: 0.75rem;
                  font-weight: 600;
                  line-height: 1.5;
                "
              >
                {{ section.settings.coming_soon_description }}
              </div>

            {% endif %}

          </div>

        {% endif %}

      </div>


      {% comment %}
        =========================================
        HERO RIGHT COLUMN
        =========================================
      {% endcomment %}

      <div
        style="
          position: relative;
          display: flex;
          flex-direction: column;
          align-items: center;
        "
      >

        {% comment %}
          =========================================
          BADGE 1
          =========================================
        {% endcomment %}

        {% if section.settings.show_badge_1
          and section.settings.badge_1_text != blank
        %}

          <div
            class="pill pill-sun rot-neg-6"
            style="
              position: absolute;
              top: 1.5rem;
              left: 1rem;
              font-size: 0.95rem;
              font-weight: 800;
              padding: 0.5rem 1rem;
              box-shadow: var(--shadow-pop-sm);
              z-index: 99999;
            "
          >
            {{ section.settings.badge_1_text }}
          </div>

        {% endif %}


        {% comment %}
          =========================================
          HERO IMAGE
          =========================================
        {% endcomment %}

        <div
          class="animate-float"
          style="
            position: relative;
            width: 100%;
            max-width: {{ section.settings.hero_image_width }}px;
            border-radius: var(--radius-xl);
            border: 2px solid var(--color-ink);
            background-color: var(--color-paper);
            box-shadow: var(--shadow-pop-lg);
            overflow: hidden;
          "
        >

          {% if section.settings.hero_image != blank %}

            <img
              src="{{ section.settings.hero_image | image_url: width: 1200 }}"
              alt="{{ section.settings.hero_image_alt | escape }}"
              width="{{ section.settings.hero_image.width }}"
              height="{{ section.settings.hero_image.height }}"
              loading="eager"
              style="
                width: 100%;
                aspect-ratio: 4/4;
                object-fit: cover;
              "
            >

          {% else %}

            <img
              src="{{ 'box_hero.webp' | asset_url }}"
              alt="{{ section.settings.hero_image_alt | escape }}"
              style="
                width: 100%;
                aspect-ratio: 4/4;
                object-fit: cover;
              "
            >

          {% endif %}

        </div>


        {% comment %}
          =========================================
          MASCOT + BADGE 2
          =========================================
        {% endcomment %}

        {% if section.settings.show_mascot
          or section.settings.show_badge_2
        %}

          <div
            class="mascot-container badge-mascot"
            style="
              margin-left: auto;
              padding-right: 40px;
              margin-top: -15px;
            "
            id="HeroFinnMascot"
          >

            {% if section.settings.show_badge_2
              and section.settings.badge_2_text != blank
            %}

              <div
                class="pill pill-berry rot-pos-3"
                style="
                  font-size: 0.95rem;
                  margin-bottom: 5px;
                  font-weight: 800;
                  padding: 0.5rem 1rem;
                  box-shadow: var(--shadow-pop-sm);
                "
              >
                {{ section.settings.badge_2_text }}
              </div>

            {% endif %}


            {% if section.settings.show_mascot %}

              <figure class="mascot-cap">

                <figcaption class="mascot-caption">
                  {{ section.settings.mascot_caption }}
                </figcaption>

                {% if section.settings.mascot_image != blank %}

                  <img
                    src="{{ section.settings.mascot_image | image_url: width: 500 }}"
                    alt="{{ section.settings.mascot_alt | escape }}"
                    width="{{ section.settings.mascot_image.width }}"
                    height="{{ section.settings.mascot_image.height }}"
                    loading="lazy"
                    style="
                      height: 140px;
                      width: auto;
                    "
                  >

                {% else %}

                  <img
                    src="{{ 'finn_mascot.png' | asset_url }}"
                    alt="{{ section.settings.mascot_alt | escape }}"
                    loading="lazy"
                    style="
                      height: 140px;
                      width: auto;
                    "
                  >

                {% endif %}

              </figure>

            {% endif %}

          </div>

        {% endif %}

      </div>

    </div>

  </div>

</section>

{% schema %}

{
  "name": "Hero Section",

  "settings": [

    {
      "type": "header",
      "content": "Region Selector"
    },

    {
      "type": "checkbox",
      "id": "show_region_selector",
      "label": "Show region selector",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_region_button",
      "label": "Show region button",
      "default": true
    },

    {
      "type": "text",
      "id": "region_button_text",
      "label": "Region button text",
      "default": "View page"
    },

    {
      "type": "url",
      "id": "region_button_link",
      "label": "Region button link"
    },


    {
      "type": "header",
      "content": "Hero Content"
    },

    {
      "type": "text",
      "id": "headline_line_1",
      "label": "Headline line 1",
      "default": "Meet your state's"
    },

    {
      "type": "text",
      "id": "headline_line_2",
      "label": "Headline highlighted line",
      "default": "best-kept secrets."
    },

    {
      "type": "color",
      "id": "headline_color",
      "label": "Headline highlight color",
      "default": "#F26B5B"
    },

    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>A themed box of small local brands with samples, stories, and exclusive offers, curated by locals and made for the unboxing. Discover six brands from your state at once.</p>"
    },


    {
      "type": "header",
      "content": "CTA Buttons"
    },

    {
      "type": "checkbox",
      "id": "show_ctas",
      "label": "Show CTA buttons",
      "default": true
    },

    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA text",
      "default": "Get the box"
    },

    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA link"
    },

    {
      "type": "checkbox",
      "id": "primary_cta_arrow",
      "label": "Show arrow on primary CTA",
      "default": true
    },

    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA text",
      "default": "Subscribe & save"
    },

    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA link"
    },

    {
      "type": "checkbox",
      "id": "secondary_cta_arrow",
      "label": "Show arrow on secondary CTA",
      "default": false
    },


    {
      "type": "header",
      "content": "Coming Soon Card"
    },

    {
      "type": "checkbox",
      "id": "show_coming_soon",
      "label": "Show coming soon card",
      "default": true
    },

    {
      "type": "text",
      "id": "coming_soon_label",
      "label": "Label",
      "default": "Coming soon"
    },

    {
      "type": "text",
      "id": "coming_soon_title",
      "label": "Title",
      "default": "Blue Ridge, NC"
    },

    {
      "type": "text",
      "id": "coming_soon_date",
      "label": "Expected date",
      "default": "Expected: Summer 2027"
    },

    {
      "type": "richtext",
      "id": "coming_soon_description",
      "label": "Description",
      "default": "<p>Subscribe today and we'll notify you the moment boxes go live in your region.</p>"
    },

    {
      "type": "range",
      "id": "coming_soon_width",
      "label": "Card maximum width",
      "min": 250,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 384
    },


    {
      "type": "header",
      "content": "Hero Image"
    },

    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },

    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero image alt text",
      "default": "The Local Discovery Box, opened with products"
    },

    {
      "type": "range",
      "id": "hero_image_width",
      "label": "Hero image maximum width",
      "min": 300,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 480
    },


    {
      "type": "header",
      "content": "Floating Badges"
    },

    {
      "type": "checkbox",
      "id": "show_badge_1",
      "label": "Show badge 1",
      "default": true
    },

    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1 text",
      "default": "6 brands inside"
    },

    {
      "type": "checkbox",
      "id": "show_badge_2",
      "label": "Show badge 2",
      "default": true
    },

    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2 text",
      "default": "Real samples & stories"
    },


    {
      "type": "header",
      "content": "Mascot"
    },

    {
      "type": "checkbox",
      "id": "show_mascot",
      "label": "Show mascot",
      "default": true
    },

    {
      "type": "image_picker",
      "id": "mascot_image",
      "label": "Mascot image"
    },

    {
      "type": "text",
      "id": "mascot_caption",
      "label": "Mascot caption",
      "default": "Finn"
    },

    {
      "type": "text",
      "id": "mascot_alt",
      "label": "Mascot alt text",
      "default": "Finn the squirrel mascot"
    },


    {
      "type": "header",
      "content": "Decorative Glows"
    },

    {
      "type": "checkbox",
      "id": "show_glow_left",
      "label": "Show left glow",
      "default": true
    },

    {
      "type": "color",
      "id": "glow_left_color",
      "label": "Left glow color",
      "default": "#FFD166"
    },

    {
      "type": "range",
      "id": "glow_left_blur",
      "label": "Left glow blur",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },

    {
      "type": "checkbox",
      "id": "show_glow_right",
      "label": "Show right glow",
      "default": true
    },

    {
      "type": "color",
      "id": "glow_right_color",
      "label": "Right glow color",
      "default": "#7AE2CE"
    },

    {
      "type": "range",
      "id": "glow_right_blur",
      "label": "Right glow blur",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    }

  ],


  "blocks": [

    {
      "type": "region",
      "name": "Region",

      "settings": [

        {
          "type": "text",
          "id": "region_name",
          "label": "Region name",
          "default": "SW Virginia (Now Available)"
        },

        {
          "type": "url",
          "id": "region_url",
          "label": "Region link"
        },

        {
          "type": "checkbox",
          "id": "selected",
          "label": "Selected by default",
          "default": false
        }

      ]

    }

  ],


  "presets": [

    {
      "name": "Hero Section",

      "blocks": [

        {
          "type": "region",
          "settings": {
            "region_name": "SW Virginia (Now Available)",
            "region_url": "/pages/regions#southwest-va",
            "selected": true
          }
        },

        {
          "type": "region",
          "settings": {
            "region_name": "Blue Ridge, NC (Summer 2027)",
            "region_url": "/pages/regions#blue-ridge-nc",
            "selected": false
          }
        },

        {
          "type": "region",
          "settings": {
            "region_name": "Texas Hill Country, TX (Fall 2027)",
            "region_url": "/pages/regions#texas-hill-country",
            "selected": false
          }
        },

        {
          "type": "region",
          "settings": {
            "region_name": "Pacific Northwest (Winter 2027)",
            "region_url": "/pages/regions#pacific-northwest",
            "selected": false
          }
        }

      ]

    }

  ]

}

{% endschema %}
<section style="padding: 5rem 0; border-bottom: 2px solid var(--color-ink); background-color: var(--color-cream);">
  <div class="container">
    <div style="text-align: center; max-width: 680px; margin: 0 auto 3.5rem;">
      <span class="pill pill-sun" style="margin-bottom: 0.75rem;">Maker Journey</span>
      <h2 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; margin-bottom: 1rem;">
        How Brand Participation Works
      </h2>
      <p class="text-ink-soft" style="font-size: 1.1rem;">
        We make it simple for small businesses to gain massive visibility without complex digital ad setup.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 2rem;">
      <!-- Step 01 -->
      <div style="border-radius: var(--radius-xl); border: 2px solid var(--color-ink); background-color: var(--color-paper); padding: 2rem; box-shadow: var(--shadow-pop); position: relative;">
        <span class="pill pill-coral" style="position: absolute; -top: 14px; left: 1.5rem; font-weight: 800;">01</span>
        <h3 style="font-size: 1.35rem; font-weight: 800; margin: 0.75rem 0 0.5rem;">Apply to Be Featured</h3>
        <p class="text-ink-soft" style="font-size: 0.95rem; line-height: 1.6;">
          Complete our short application below. Tell us about your story, where you're located, and what makes your goods exceptional.
        </p>
      </div>

      <!-- Step 02 -->
      <div style="border-radius: var(--radius-xl); border: 2px solid var(--color-ink); background-color: var(--color-teal-light); padding: 2rem; box-shadow: var(--shadow-pop); position: relative;">
        <span class="pill pill-teal" style="position: absolute; -top: 14px; left: 1.5rem; font-weight: 800;">02</span>
        <h3 style="font-size: 1.35rem; font-weight: 800; margin: 0.75rem 0 0.5rem;">Choose What to Include</h3>
        <p class="text-ink-soft" style="font-size: 0.95rem; line-height: 1.6;">
          We collaborate with you to pick the ideal sample, full-size item, or special voucher that best introduces shoppers to your brand.
        </p>
      </div>

      <!-- Step 03 -->
      <div style="border-radius: var(--radius-xl); border: 2px solid var(--color-ink); background-color: var(--color-sun-light); padding: 2rem; box-shadow: var(--shadow-pop); position: relative;">
        <span class="pill pill-sun" style="position: absolute; -top: 14px; left: 1.5rem; font-weight: 800;">03</span>
        <h3 style="font-size: 1.35rem; font-weight: 800; margin: 0.75rem 0 0.5rem;">We Package & Ship</h3>
        <p class="text-ink-soft" style="font-size: 0.95rem; line-height: 1.6;">
          We write your feature in the printed field guide, photograph the collection, assemble every box with care, and mail them to homes.
        </p>
      </div>

      <!-- Step 04 -->
      <div style="border-radius: var(--radius-xl); border: 2px solid var(--color-ink); background-color: var(--color-berry-light); padding: 2rem; box-shadow: var(--shadow-pop); position: relative;">
        <span class="pill pill-berry" style="position: absolute; -top: 14px; left: 1.5rem; font-weight: 800;">04</span>
        <h3 style="font-size: 1.35rem; font-weight: 800; margin: 0.75rem 0 0.5rem;">Earn Real Customers</h3>
        <p class="text-ink-soft" style="font-size: 0.95rem; line-height: 1.6;">
          Customers scan your QR code, explore your website, redeem their exclusive perks, and become lifelong patrons.
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Steps",
  "settings": [],
  "presets": [
    {
      "name": "Brand Steps"
    }
  ]
}
{% endschema %}

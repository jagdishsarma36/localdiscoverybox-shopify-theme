<section style="padding: 4.5rem 0 6rem; background-color: var(--color-cream);">
  <div class="container-narrow">
    
    <!-- Account Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        <span class="pill pill-coral" style="margin-bottom: 0.5rem;">Subscriber Dashboard</span>
        <h1 style="font-size: 2.5rem; font-weight: 800;">My Boxes & Account</h1>
        <p class="text-ink-soft">Hi {{ customer.first_name | default: customer.email }}, manage your seasonal orders and subscriptions here.</p>
      </div>
      <div>
        <a href="/account/logout" class="btn btn-ghost btn-sm" style="border: 2px solid var(--color-ink);">Log Out</a>
      </div>
    </div>

    <!-- Active Subscription Management Card -->
    <div style="background-color: var(--color-paper); border: 2px solid var(--color-ink); border-radius: var(--radius-xl); padding: 2rem; box-shadow: var(--shadow-pop); margin-bottom: 2.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span style="font-size: 1.5rem;">📦</span>
          <h2 style="font-size: 1.4rem; font-weight: 800;">Subscription Status</h2>
        </div>
        <span class="pill pill-teal" style="font-size: 0.8rem;">Active / Up to Date</span>
      </div>

      <p class="text-ink-soft" style="font-size: 0.95rem; margin-bottom: 1.5rem;">
        Your recurring seasonal box orders are powered by Shopify Subscriptions. You can update delivery addresses, pause your subscription, or skip an upcoming edition anytime.
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
        <div style="background-color: var(--color-cream); border: 2px dashed rgba(0, 23, 79, 0.2); border-radius: var(--radius-md); padding: 1rem;">
          <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--color-ink-soft);">Current Edition</div>
          <div style="font-family: var(--font-display); font-weight: 800; font-size: 1.1rem; margin-top: 0.25rem;">Southwest Virginia</div>
        </div>
        <div style="background-color: var(--color-cream); border: 2px dashed rgba(0, 23, 79, 0.2); border-radius: var(--radius-md); padding: 1rem;">
          <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--color-ink-soft);">Cadence</div>
          <div style="font-family: var(--font-display); font-weight: 800; font-size: 1.1rem; margin-top: 0.25rem;">Season Pass ($69/quarter)</div>
        </div>
        <div style="background-color: var(--color-cream); border: 2px dashed rgba(0, 23, 79, 0.2); border-radius: var(--radius-md); padding: 1rem;">
          <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--color-ink-soft);">Next Shipment</div>
          <div style="font-family: var(--font-display); font-weight: 800; font-size: 1.1rem; margin-top: 0.25rem;">Next Seasonal Drop</div>
        </div>
      </div>

      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <!-- Shopify Subscription Customer Portal Link -->
        <a href="/tools/recurring/portal" class="btn btn-teal btn-md">
          Manage Subscription in Portal
        </a>
        <a href="/account/addresses" class="btn btn-ghost btn-md" style="border: 2px solid var(--color-ink);">
          Edit Shipping Addresses ({{ customer.addresses_count }})
        </a>
      </div>
    </div>

    <!-- Order History -->
    <div style="background-color: var(--color-paper); border: 2px solid var(--color-ink); border-radius: var(--radius-xl); padding: 2rem; box-shadow: var(--shadow-pop);">
      <h2 style="font-size: 1.4rem; font-weight: 800; margin-bottom: 1.25rem;">Order History</h2>

      {% paginate customer.orders by 10 %}
        {% if customer.orders.size > 0 %}
          <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem;">
              <thead>
                <tr style="border-bottom: 2px solid var(--color-ink); font-family: var(--font-display); font-weight: 700;">
                  <th style="padding: 0.75rem 0.5rem;">Order</th>
                  <th style="padding: 0.75rem 0.5rem;">Date</th>
                  <th style="padding: 0.75rem 0.5rem;">Payment</th>
                  <th style="padding: 0.75rem 0.5rem;">Fulfillment</th>
                  <th style="padding: 0.75rem 0.5rem;">Total</th>
                </tr>
              </thead>
              <tbody>
                {% for order in customer.orders %}
                  <tr style="border-bottom: 1px dashed rgba(0, 23, 79, 0.2);">
                    <td style="padding: 0.85rem 0.5rem;">
                      <a href="{{ order.customer_url }}" style="font-weight: 700; color: var(--color-coral);">{{ order.name }}</a>
                    </td>
                    <td style="padding: 0.85rem 0.5rem;">{{ order.created_at | date: "%b %d, %Y" }}</td>
                    <td style="padding: 0.85rem 0.5rem;">{{ order.financial_status_label }}</td>
                    <td style="padding: 0.85rem 0.5rem;">{{ order.fulfillment_status_label }}</td>
                    <td style="padding: 0.85rem 0.5rem; font-weight: 700;">{{ order.total_net_amount | money_with_currency }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div style="text-align: center; padding: 2rem 0;">
            <p class="text-ink-soft" style="margin-bottom: 1rem;">You haven't placed an order yet.</p>
            <a href="/products/the-local-discovery-box" class="btn btn-coral btn-md">Get Your First Box</a>
          </div>
        {% endif %}
        {{ paginate | default_pagination }}
      {% endpaginate %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Customer Account",
  "settings": []
}
{% endschema %}

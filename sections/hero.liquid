      "default": "6 brands inside"
    },

    {
      "type": "checkbox",
      "id": "show_badge_2",
      "label": "Show badge 2",
      "default": true
    },

    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2 text",
      "default": "Real samples & stories"
    },


    {
      "type": "header",
      "content": "Mascot"
    },

    {
      "type": "checkbox",
      "id": "show_mascot",
      "label": "Show mascot",
      "default": true
    },

    {
      "type": "image_picker",
      "id": "mascot_image",
      "label": "Mascot image"
    },

    {
      "type": "text",
      "id": "mascot_caption",
      "label": "Mascot caption",
      "default": "Finn"
    },

    {
      "type": "text",
      "id": "mascot_alt",
      "label": "Mascot alt text",
      "default": "Finn the squirrel mascot"
    },


    {
      "type": "header",
      "content": "Decorative Glows"

<section style="padding: 4.5rem 0; border-bottom: 2px solid var(--color-ink); background-color: var(--color-paper);">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
      
      <!-- Metric 1 -->
      <div style="border-radius: var(--radius-xl); border: 2px solid var(--color-ink); background-color: var(--color-cream); padding: 2rem; box-shadow: var(--shadow-pop);">
        <div style="font-size: 2rem; margin-bottom: 0.5rem;">🎯</div>
        <div style="font-family: var(--font-display); font-size: 3rem; font-weight: 800; color: var(--color-coral); line-height: 1;">
          $10
        </div>
        <div style="font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; margin: 0.5rem 0;">
          per trial, with attribution
        </div>
        <p class="text-ink-soft" style="font-size: 0.95rem; line-height: 1.6;">
          A direct all-in campaign puts your physical product directly in 100 pre-qualified, discovery-loving local households.
        </p>
      </div>

      <!-- Metric 2 -->
      <div style="border-radius: var(--radius-xl); border: 2px solid var(--color-ink); background-color: var(--color-teal-light); padding: 2rem; box-shadow: var(--shadow-pop);">
        <div style="font-size: 2rem; margin-bottom: 0.5rem;">📍</div>
        <div style="font-family: var(--font-display); font-size: 3rem; font-weight: 800; color: var(--color-ink); line-height: 1;">
          100%
        </div>
        <div style="font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; margin: 0.5rem 0;">
          targeted local shoppers
        </div>
        <p class="text-ink-soft" style="font-size: 0.95rem; line-height: 1.6;">
          Zero ad waste. Every box goes to verified regional residents and fans eager to support homegrown businesses.
        </p>
      </div>

      <!-- Metric 3 -->
      <div style="border-radius: var(--radius-xl); border: 2px solid var(--color-ink); background-color: var(--color-sun-light); padding: 2rem; box-shadow: var(--shadow-pop);">
        <div style="font-size: 2rem; margin-bottom: 0.5rem;">📲</div>
        <div style="font-family: var(--font-display); font-size: 3rem; font-weight: 800; color: var(--color-coral-dark); line-height: 1;">
          Measurable
        </div>
        <div style="font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; margin: 0.5rem 0;">
          QR tracking & direct sales
        </div>
        <p class="text-ink-soft" style="font-size: 0.95rem; line-height: 1.6;">
          Each box feature includes your dedicated QR offer code, letting you track website visits, signups, and first-order redemptions.
        </p>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Metrics",
  "settings": [],
  "presets": [
    {
      "name": "Brand Metrics"
    }
  ]
}
{% endschema %}

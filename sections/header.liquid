<header class="site-header" data-site-header>
  {% if section.settings.show_announcement and section.settings.announcement_text != blank %}
    <div style="background-color: var(--color-sun); border-bottom: 2px solid var(--color-ink); padding: 0.4rem 1rem; text-align: center; font-family: var(--font-display); font-weight: 700; font-size: 0.85rem;">
      {{ section.settings.announcement_text }}
    </div>
  {% endif %}

  <div class="header-inner">
    <!-- Brand Logo -->
    <a href="/" class="header-logo" aria-label="{{ shop.name }}">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 500 }}" alt="{{ shop.name }}" width="{{ section.settings.logo_width | default: 220 }}">
      {% elsif settings.logo != blank %}
        <img src="{{ settings.logo | image_url: width: 500 }}" alt="{{ shop.name }}" width="{{ settings.logo_width | default: 220 }}">
      {% else %}
        <img src="{{ 'logo.png' | asset_url }}" alt="The Local Discovery Box" width="{{ section.settings.logo_width | default: 220 }}">
      {% endif %}
    </a>

    <!-- Desktop Navigation -->
    <nav class="header-nav" role="navigation">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}" class="nav-link {% if link.active %}active{% endif %}">
          {{ link.title }}
        </a>
      {% else %}
        <!-- Default Navigation if menu not yet set in admin -->
        <a href="/#the-box" class="nav-link">The Box</a>
        <a href="/pages/regions" class="nav-link">State</a>
        <a href="/pages/subscribe" class="nav-link">Subscribe</a>
        <a href="/pages/for-brands" class="nav-link">For Brands</a>
      {% endfor %}
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      {% if shop.customer_accounts_enabled %}
        {% if customer %}
          <a href="/account" class="btn btn-ghost btn-sm" style="font-family: var(--font-display); font-weight: 700;">
            My Boxes
          </a>
        {% else %}
          <a href="/account/login" class="btn btn-teal btn-sm" style="display: none;" id="DesktopLoginLink">
            Log in
          </a>
          <script>
            if (window.innerWidth > 768) {
              document.getElementById('DesktopLoginLink').style.display = 'inline-flex';
            }
          </script>
        {% endif %}
      {% endif %}

      <!-- Cart Button -->
      <button type="button" class="cart-btn" data-cart-trigger aria-label="Cart">
        {% render 'icon-cart' %}
        <span class="cart-count" data-cart-count style="{% if cart.item_count == 0 %}display: none;{% endif %}">
          {{ cart.item_count }}
        </span>
      </button>

      <!-- Mobile Menu Toggle -->
      <button type="button" class="mobile-menu-toggle" data-mobile-menu-toggle aria-label="Toggle navigation">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="mobile-drawer-overlay" data-mobile-drawer-overlay></div>
<div class="mobile-nav-drawer" data-mobile-nav-drawer>
  <div style="display: flex; align-items: center; justify-content: space-between;">
    <a href="/" style="display: block; width: 160px;">
      <img src="{{ 'logo.png' | asset_url }}" alt="Local Discovery Box">
    </a>
    <button type="button" class="cart-drawer-close" data-mobile-drawer-close aria-label="Close menu">
      {% render 'icon-close' %}
    </button>
  </div>

  <ul class="mobile-nav-links">
    {% for link in linklists[section.settings.menu].links %}
      <li>
        <a href="{{ link.url }}" class="nav-link {% if link.active %}active{% endif %}" data-mobile-drawer-close>
          {{ link.title }}
        </a>
      </li>
    {% else %}
      <li><a href="/#the-box" class="nav-link" data-mobile-drawer-close>The Box</a></li>
      <li><a href="/pages/regions" class="nav-link" data-mobile-drawer-close>State</a></li>
      <li><a href="/pages/subscribe" class="nav-link" data-mobile-drawer-close>Subscribe</a></li>
      <li><a href="/pages/for-brands" class="nav-link" data-mobile-drawer-close>For Brands</a></li>
    {% endfor %}
  </ul>

  <div style="margin-top: auto; padding-top: 2rem; border-top: 2px dashed rgba(0, 23, 79, 0.2);">
    {% if customer %}
      <a href="/account" class="btn btn-teal btn-md" style="width: 100%; margin-bottom: 0.75rem;">My Boxes</a>
      <a href="/account/logout" class="btn btn-ghost btn-sm" style="width: 100%;">Log Out</a>
    {% else %}
      <a href="/account/login" class="btn btn-teal btn-md" style="width: 100%; margin-bottom: 0.75rem;">Log In</a>
      <a href="/products/the-local-discovery-box" class="btn btn-coral btn-md" style="width: 100%;">Get The Box</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 120,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Custom Logo Width",
      "default": 240
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": false
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "Limited First Edition · Shipping across Southwest Virginia & beyond!!"
    }
  ]
}
{% endschema %}

<section class="hero-section relative overflow-hidden">
  <!-- Decorative Glows -->
  <div class="pointer-events-none absolute -left-10 top-16 h-40 w-40 rounded-full bg-sun/50 blur-2xl"></div>
  <div class="pointer-events-none absolute -right-8 bottom-8 h-52 w-52 rounded-full bg-teal/40 blur-3xl"></div>

  <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-14 md:grid-cols-2 md:py-20">

    <!-- Hero Left Column -->
    <div class="animate-pop-in">

      <!-- Region Selector -->
      <div class="flex flex-wrap items-center gap-2 sm:gap-3">

        <div class="inline-flex items-center gap-2 rounded-full border-2 border-ink bg-paper px-3 py-1.5 font-display text-sm font-bold shadow-pop-sm max-w-[220px] sm:max-w-none">

          {% render 'icon-map-pin' %}

          <select
            class="bg-transparent font-display font-bold text-ink outline-none cursor-pointer min-w-0 truncate"
            onchange="if(this.value) window.location.href='/pages/regions#' + this.value"
          >
            <option value="southwest-va" selected>
              SW Virginia (Now Available)
            </option>

            <option value="blue-ridge-nc">
              Blue Ridge, NC (Summer 2027)
            </option>

            <option value="texas-hill-country">
              Texas Hill Country, TX (Fall 2027)
            </option>

            <option value="pacific-northwest">
              Pacific Northwest (Winter 2027)
            </option>

            <option value="hudson-valley">
              Hudson Valley, NY (Spring 2028)
            </option>

            <option value="lowcountry-sc">
              Lowcountry, SC (Summer 2028)
            </option>

            <option value="richmond-va">
              Richmond, VA (Fall 2028)
            </option>

            <option value="northern-va-dc">
              N. Virginia & DC (Winter 2028)
            </option>
          </select>
        </div>

        <a
          href="/pages/regions"
          class="inline-flex items-center gap-1 rounded-full border-2 border-ink bg-sun px-3 py-1.5 font-display text-sm font-bold shadow-pop-sm hover:-translate-y-0.5 transition-transform whitespace-nowrap"
        >
          <span>View page</span>
          {% render 'icon-arrow-right' %}
        </a>

      </div>

      <!-- Headline -->
      <h1 class="mt-5 font-display text-4xl font-extrabold leading-tight md:text-5xl lg:text-6xl">
        Meet your state's<br>
        <span class="text-coral whitespace-nowrap">
          best-kept secrets.
        </span>
      </h1>

      <!-- Description -->
      <p class="mt-5 max-w-md text-lg text-ink-soft">
        A themed box of small local brands with samples, stories, and exclusive offers,
        curated by locals and made for the unboxing. Discover six brands from your state at once.
      </p>

      <!-- CTA Buttons -->
      <div class="mt-7 flex flex-wrap gap-3">

        <a
          href="/products/the-local-discovery-box"
          class="inline-flex items-center justify-center gap-2 font-display font-bold rounded-full border-2 border-ink transition-transform duration-150 active:translate-x-[2px] active:translate-y-[2px] active:shadow-none bg-coral text-cream shadow-pop hover:-translate-y-0.5 text-lg px-8 py-4"
        >
          <span>Get the box</span>
          {% render 'icon-arrow-right' %}
        </a>

        <a
          href="/pages/subscribe"
          class="inline-flex items-center justify-center gap-2 font-display font-bold rounded-full border-2 border-ink transition-transform duration-150 active:translate-x-[2px] active:translate-y-[2px] active:shadow-none bg-teal text-ink shadow-pop hover:-translate-y-0.5 text-lg px-8 py-4"
        >
          <span>Subscribe & save</span>
        </a>

      </div>

      <!-- Scarcity Box -->
      <div class="mt-8 max-w-sm rounded-2xl border-2 border-ink bg-paper p-4 shadow-pop">

        <div class="font-display text-sm font-extrabold text-coral-dark uppercase tracking-wide">
          Limited first run
        </div>

        <div class="mt-1 font-display text-xl font-extrabold">
          34 of 100 boxes left
        </div>

        <div class="mt-3 h-3 w-full overflow-hidden rounded-full border-2 border-ink bg-paper">
          <div
            class="h-full bg-coral"
            style="width: 66%;"
          ></div>
        </div>

        <div class="mt-2 flex items-center justify-between">
          <p class="text-xs font-semibold text-ink-soft">
            Once they're gone, they're gone.
          </p>

          <span class="font-display text-sm font-extrabold text-coral-dark">
            $59 / box
          </span>
        </div>

      </div>

    </div>

    <!-- Hero Right Column -->
    <div class="flex flex-col gap-4">

      <div class="relative">

        <!-- Box Image -->
        <div class="animate-float overflow-hidden rounded-3xl border-2 border-ink bg-paper shadow-pop-lg">

          <img
            src="{{ 'box_hero.webp' | asset_url }}"
            alt="The Local Discovery Box, opened with products"
            class="aspect-square w-full object-cover md:aspect-[4/5]"
          >

        </div>

        <!-- Badge 1 -->
        <div class="absolute -left-3 top-6 -rotate-6 rounded-xl border-2 border-ink bg-sun px-3 py-2 font-display text-sm font-extrabold shadow-pop-sm">
          6 brands inside
        </div>

        <!-- Badge 2 -->
        <div class="absolute -bottom-3 right-6 rotate-3 rounded-xl border-2 border-ink bg-berry px-3 py-2 font-display text-sm font-extrabold text-cream shadow-pop-sm">
          Real samples & stories
        </div>

      </div>

      <!-- Finn Mascot -->
      <figure class="flex items-end gap-2 self-end pr-2">

        <figcaption class="mb-4 font-display text-base font-bold text-ink">
          Finn
        </figcaption>

        <img
          src="{{ 'finn_mascot.png' | asset_url }}"
          alt="Finn the squirrel mascot"
          class="h-40 w-auto drop-shadow-lg"
        >

      </figure>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Meet your state's best-kept secrets."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A themed box of small local brands with samples, stories, and exclusive offers, curated by locals and made for the unboxing. Discover six brands from your state at once."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA Text",
      "default": "Get the box"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA Link"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Text",
      "default": "Subscribe & save"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Section"
    }
  ]
}
{% endschema %}

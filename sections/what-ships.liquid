<section style="position: relative; padding: 5rem 0; border-bottom: 2px solid var(--color-ink); background-color: var(--color-paper);">
  <div class="container">

  <!-- Mascot Lo the Strawberry -->
        <figure class="mascot-container" id="HeroLoMascot">
          <img src="{{ 'lo_mascot.png' | asset_url }}" alt="Lo the strawberry mascot" style="height: 150px; width: auto;">
          <figcaption class="mascot-caption">Lo</figcaption>
        </figure>

    <div style="max-width: 680px; margin-bottom: 3.5rem;">
      <span class="pill pill-coral" style="margin-bottom: 0.75rem;">What Actually Ships</span>
      <h2 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; margin-bottom: 1rem;">
        It's a whole campaign, not just a box.
      </h2>
      <p class="text-ink-soft" style="font-size: 1.15rem; line-height: 1.6;">
        The box is the artifact you photograph. Every seasonal edition includes four tangible layers designed to connect you directly to the makers.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 2rem;">
      <!-- Artifact 1 -->
      <div style="border-radius: var(--radius-lg); border: 2px solid var(--color-ink); background-color: var(--color-cream); padding: 1.75rem; box-shadow: var(--shadow-pop); display: flex; flex-direction: column;">
        <div style="width: 48px; height: 48px; border-radius: var(--radius-md); border: 2px solid var(--color-ink); background-color: var(--color-sun); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 1.25rem;">
          📦
        </div>
        <h3 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 0.6rem;">
          6 Handpicked Products
        </h3>
        <p class="text-ink-soft" style="font-size: 0.95rem; line-height: 1.6;">
          Real trial samples, full-size specialty goods, artisan treats, and handmade creations you can touch, taste, smell, and enjoy.
        </p>
      </div>

      <!-- Artifact 2 -->
      <div style="border-radius: var(--radius-lg); border: 2px solid var(--color-ink); background-color: var(--color-teal-light); padding: 1.75rem; box-shadow: var(--shadow-pop); display: flex; flex-direction: column;">
        <div style="width: 48px; height: 48px; border-radius: var(--radius-md); border: 2px solid var(--color-ink); background-color: var(--color-teal); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 1.25rem;">
          📖
        </div>
        <h3 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 0.6rem;">
          The Maker Field Guide
        </h3>
        <p class="text-ink-soft" style="font-size: 0.95rem; line-height: 1.6;">
          A beautifully printed booklet telling the human story behind each company, where their workshop is located, and why they started.
        </p>
      </div>

      <!-- Artifact 3 -->
      <div style="border-radius: var(--radius-lg); border: 2px solid var(--color-ink); background-color: var(--color-coral-light); padding: 1.75rem; box-shadow: var(--shadow-pop); display: flex; flex-direction: column;">
        <div style="width: 48px; height: 48px; border-radius: var(--radius-md); border: 2px solid var(--color-ink); background-color: var(--color-coral); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 1.25rem;">
          🎟️
        </div>
        <h3 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 0.6rem;">
          Exclusive QR Offers
        </h3>
        <p class="text-ink-soft" style="font-size: 0.95rem; line-height: 1.6;">
          Scan each brand's direct QR code inside to unlock subscriber-only first-order discounts, free gifts, and special shop perks.
        </p>
      </div>

      <!-- Artifact 4 -->
      <div style="border-radius: var(--radius-lg); border: 2px solid var(--color-ink); background-color: var(--color-berry-light); padding: 1.75rem; box-shadow: var(--shadow-pop); display: flex; flex-direction: column;">
        <div style="width: 48px; height: 48px; border-radius: var(--radius-md); border: 2px solid var(--color-ink); background-color: var(--color-sun); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 1.25rem;">
          🎨
        </div>
        <h3 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 0.6rem;">
          Regional Keepsake Art
        </h3>
        <p class="text-ink-soft" style="font-size: 0.95rem; line-height: 1.6;">
          A collectible regional art print and sticker celebrating the local landmarks and cultural character of the region.
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "What Actually Ships",
  "settings": [],
  "presets": [
    {
      "name": "What Actually Ships"
    }
  ]
}
{% endschema %}
